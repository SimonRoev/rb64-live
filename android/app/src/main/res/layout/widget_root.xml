<?xml version="1.0" encoding="utf-8"?>
<!-- Widget nach Regeln v2 (Entwurf D): Petrol-Kopf + Verlaufsstreifen, naechster Zug als Karte, danach Liste, Datenstand -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical">

    <!-- Kopf 48: Strecke + Richtung tauschen -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/widget_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp">
        <TextView
            android:id="@+id/route"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_on_header"
            android:textSize="16sp" />
        <ImageView
            android:id="@+id/swap"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Richtung tauschen"
            android:padding="12dp"
            android:src="@drawable/ic_swap"
            android:tint="@color/widget_on_header" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/strip"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@drawable/widget_strip" />

    <TextView
        android:id="@+id/note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/widget_note"
        android:ellipsize="end"
        android:maxLines="1"
        android:padding="8dp"
        android:textColor="@color/status_warn"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Naechster Zug -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_card"
        android:orientation="vertical"
        android:padding="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/hero_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textColor="@color/widget_text"
                android:textSize="32sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/hero_plan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/widget_muted"
                android:textSize="13sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/hero_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
        <TextView
            android:id="@+id/hero_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/hero_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Fruehere Zuege ein-/ausblenden -->
    <TextView
        android:id="@+id/past_toggle"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="@color/widget_primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/list_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_card"
        android:clipToOutline="true">
        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/widget_line"
            android:dividerHeight="1dp" />
        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="16dp"
            android:text="Noch keine Daten – App einmal öffnen"
            android:textColor="@color/widget_muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Datenstand, antippen = aktualisieren -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageView
            android:id="@+id/footer_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_refresh"
            android:tint="@color/widget_muted" />
        <TextView
            android:id="@+id/updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
